# Gradle / Android build artifacts
.gradle/
build/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Mobile development environment (not part of the game project)
.bash_history
.cache/
.config/
.local/
.opencode/
.termux/
tooling/
*.deb
opencode.json

# Local credentials / device SSH (never commit)
.git-credentials
.ssh/

# Release signing material — the production keystore lives outside the repo
# and is reconstructed from a Actions secret into $RUNNER_TEMP only. None of
# these may ever be committed, and the decoded copy must never be staged.
*.keystore
*.keystore.base64
*.jks
*.p12
local-signing.properties
*.pepk

# Logo generator build output (Java)
branding/*.class

# Device/toolchain files local to this machine — not project content
environment/
